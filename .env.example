# local = clearly-labelled mock auth/Drive; clerk-google = production providers
TRIPNEST_PROVIDER_MODE=clerk-google
NEXT_PUBLIC_TRIPNEST_PROVIDER_MODE=clerk-google
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://tripnest:tripnest@localhost:5432/tripnest?schema=public

# Clerk production configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
ADMIN_CLERK_USER_IDS=

# Google OAuth and encryption (32-byte key encoded as 64 hex characters)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ENCRYPTION_KEY=
GOOGLE_DRIVE_ROOT_1_URL=
GOOGLE_DRIVE_ROOT_2_URL=
GOOGLE_DRIVE_ROOT_3_URL=
GOOGLE_DRIVE_ROOT_4_URL=
GOOGLE_DRIVE_ROOT_5_URL=

# Optional Workspace service-account credential (base64 JSON; never public)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Development-only mock provider identity and storage
MOCK_USER_EMAIL=demo@tripnest.local
MOCK_USER_NAME=TripNest Explorer
MOCK_DRIVE_PATH=.tripnest-mock-drive
