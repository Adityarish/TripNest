{
  "name": "tripnest",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clerk": "TRIPNEST_PROVIDER_MODE=clerk-google NEXT_PUBLIC_TRIPNEST_PROVIDER_MODE=clerk-google next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "extension:zip": "cd extension && zip -r ../tripnest-extension.zip ."
  },
  "dependencies": {
    "@clerk/nextjs": "latest",
    "@prisma/client": "6.19.3",
    "@serwist/next": "latest",
    "@serwist/sw": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "date-fns": "latest",
    "googleapis": "latest",
    "lucide-react": "latest",
    "next": "^16.4.0",
    "react": "latest",
    "react-dom": "latest",
    "serwist": "latest",
    "server-only": "latest",
    "sonner": "latest",
    "svix": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "prisma": "6.19.3",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
